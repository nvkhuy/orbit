---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/animations.css';
import Nav from './Nav.astro';

interface Props {
	title?: string;
}

const { title = "Orbit" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Orbit - Serverless local-first project management app" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div style="max-width: 1320px; margin: 0 auto; padding: 1.25rem 1.5rem;">
			<Nav />
			<main style="margin-top: 1.25rem;">
				<slot />
			</main>
		</div>
	</body>
</html>
