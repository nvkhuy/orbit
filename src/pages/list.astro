---
import BaseLayout from '../components/BaseLayout.astro';
import TaskListView from '../components/TaskListView';
import { readProjectsFromDisk, readTasksFromDisk } from '../lib/content';

const rawProjects = readProjectsFromDisk();
const rawTasks = readTasksFromDisk();

const projects = rawProjects.map(p => ({
  slug: p.id.replace(/\.md$/, ''),
  title: p.data.title,
  columns: p.data.columns,
  color: p.data.color,
}));

const tasks = rawTasks.map(t => ({
  slug: t.id.replace(/\.md$/, ''),
  title: t.data.title,
  project: t.data.project,
  status: t.data.status,
  priority: t.data.priority,
  assignee: t.data.assignee,
  tags: t.data.tags,
  due: t.data.due ? String(t.data.due) : undefined,
  order: t.data.order,
  parent: t.data.parent,
}));
---

<BaseLayout title="Orbit - Task List View">
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <h1 style="font-size: 3rem; transform: rotate(1deg);">📄 Task Master List</h1>
    <TaskListView client:load initialTasks={tasks} projects={projects} />
  </div>
</BaseLayout>
