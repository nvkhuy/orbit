---
import BaseLayout from '../../components/BaseLayout.astro';
import ProjectEditor from '../../components/ProjectEditor';
import KanbanBoard from '../../components/KanbanBoard';
import { readTasksFromDisk } from '../../lib/content';
import { getCollection, getEntry } from 'astro:content';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const projectEntry = await getEntry('projects', slug);
if (!projectEntry) return Astro.redirect('/');

const rawProjects = await getCollection('projects');
const rawTasks = readTasksFromDisk();

const projects = rawProjects.map(p => ({
  slug: p.id.replace(/\.md$/, ''),
  title: p.data.title,
  columns: p.data.columns,
  color: p.data.color,
}));

const tasks = rawTasks.map(t => ({
  slug: t.id.replace(/\.md$/, ''),
  title: t.data.title,
  project: t.data.project,
  status: t.data.status,
  priority: t.data.priority,
  assignee: t.data.assignee,
  tags: t.data.tags,
  due: t.data.due ? String(t.data.due) : undefined,
  order: t.data.order,
  parent: t.data.parent,
}));

const initialProject = {
  slug: projectEntry.id.replace(/\.md$/, ''),
  title: projectEntry.data.title,
  status: projectEntry.data.status,
  priority: projectEntry.data.priority,
  columns: projectEntry.data.columns,
  color: projectEntry.data.color,
  body: projectEntry.body || '',
};

// Calculate progress percentage
const projectTasks = tasks.filter(t => t.project === initialProject.slug);
const doneCount = projectTasks.filter(t => t.status === 'done').length;
const progressPct = projectTasks.length > 0 ? Math.round((doneCount / projectTasks.length) * 100) : 0;
---

<BaseLayout title={`Project - ${initialProject.title}`}>
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    {/* Project Header Card */}
    <ProjectEditor client:load initialProject={initialProject} />

    {/* Hand-Drawn Progress Bar */}
    <div class="sketch-card" style="padding: 1.25rem;">
      <div style="display: flex; justify-content: space-between; font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 0.5rem;">
        <span>Project Progress</span>
        <span>{doneCount} / {projectTasks.length} Done ({progressPct}%)</span>
      </div>
      <div class="wobbly-border-sm" style="height: 24px; background-color: var(--muted); overflow: hidden; padding: 2px;">
        <div 
          style={`height: 100%; width: ${progressPct}%; background-color: var(--accent); border-radius: 4px; transition: width 0.3s ease;`}
        />
      </div>
    </div>

    {/* Filtered Project Kanban Board */}
    <div>
      <h2 style="font-size: 2.25rem; margin-bottom: 1rem; transform: rotate(-1deg);">Project Board</h2>
      <KanbanBoard client:load initialTasks={tasks} projects={projects} initialProjectFilter={initialProject.slug} />
    </div>
  </div>
</BaseLayout>
