---
interface Props {
  color?: string; // Hex color for the badge background
}

const { color = 'var(--postit)' } = Astro.props;
---

<span class="sketch-badge" style={`background-color: ${color};`}>
  <slot />
</span>

<style>
  .sketch-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--border);
    border-radius: var(--radius-wobbly-sm);
    font-size: 0.9rem;
    font-family: var(--font-body);
    box-shadow: 2px 2px 0px 0px var(--border);
    transform: rotate(-1deg);
  }
</style>
