---
const currentPath = Astro.url.pathname;
---

<nav style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px dashed var(--border); padding: 0.25rem 0 1rem; margin-bottom: 1.25rem;">
	<div style="font-family: var(--font-heading); font-size: 2.1rem; transform: rotate(-2deg);">
		<a href="/">🪐 Orbit</a>
	</div>
	<ul style="list-style: none; display: flex; gap: 1.75rem; font-size: 1.3rem;">
		<li><a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Dashboard</a></li>
		<li><a href="/board" class={`nav-link ${currentPath.startsWith('/board') ? 'active' : ''}`}>Board</a></li>
		<li><a href="/list" class={`nav-link ${currentPath.startsWith('/list') ? 'active' : ''}`}>List</a></li>
		<li><a href="/agents" class={`nav-link ${currentPath.startsWith('/agents') ? 'active' : ''}`}>Agents</a></li>
	</ul>
	<div>
		<a href="/new?type=project" class="sketch-button" style="padding: 0.4rem 1.15rem; font-size: 1.1rem;"><span>+ New Project</span></a>
	</div>
</nav>

<style>
	a {
		color: var(--fg);
	}

	ul a {
		text-decoration: none;
	}

	ul a.active {
		font-weight: bold;
	}

	.nav-link {
		display: inline-block;
		transition: transform 0.15s ease, color 0.15s ease;
	}

	.nav-link:hover {
		color: var(--accent);
		transform: translateY(-2px) rotate(-1deg);
	}

	.nav-link:active {
		transform: translateY(2px) scale(0.96);
	}
</style>
