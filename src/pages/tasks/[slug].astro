---
import BaseLayout from '../../components/BaseLayout.astro';
import TaskEditor from '../../components/TaskEditor';
import { readProjectsFromDisk, readTaskFromDisk } from '../../lib/content';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/board');

const taskEntry = readTaskFromDisk(slug);
if (!taskEntry) return Astro.redirect('/board');

const rawProjects = readProjectsFromDisk();
const projects = rawProjects.map(p => ({
  slug: p.id.replace(/\.md$/, ''),
  title: p.data.title,
  columns: p.data.columns,
  color: p.data.color,
}));

const initialTask = {
  id: taskEntry.id,
  slug: taskEntry.id.replace(/\.md$/, ''),
  title: taskEntry.data.title,
  project: taskEntry.data.project,
  status: taskEntry.data.status,
  priority: taskEntry.data.priority,
  assignee: taskEntry.data.assignee,
  tags: taskEntry.data.tags,
  due: taskEntry.data.due ? String(taskEntry.data.due) : undefined,
  order: taskEntry.data.order,
  parent: taskEntry.data.parent,
  body: taskEntry.body || '',
};
---

<BaseLayout title={`Task - ${initialTask.title}`}>
  <TaskEditor client:load initialTask={initialTask} projects={projects} />
</BaseLayout>
