---
import BaseLayout from '../../components/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { slug: p.slug || p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const allTasks = await getCollection('tasks');
const projectTasks = allTasks.filter(
  (t) => t.data.project === (project.slug || project.id)
);

const doneCount = projectTasks.filter((t) => t.data.status === 'done').length;
const progress = projectTasks.length > 0 ? Math.round((doneCount / projectTasks.length) * 100) : 0;
---

<BaseLayout title={`Orbit — Project: ${project.data.title}`}>
  <div class="project-detail-header">
    <div class="header-left">
      <div class="project-badges">
        <span class={`badge-sketch badge-${project.data.status}`}>{project.data.status}</span>
        <span class={`badge-sketch badge-${project.data.priority}`}>{project.data.priority}</span>
      </div>
      <h1>📁 {project.data.title}</h1>
    </div>

    <div class="header-right">
      <a href={`/board?project=${project.slug || project.id}`} class="btn-sketch btn-sketch-yellow">
        📋 View in Kanban
      </a>
      <a href="/new" class="btn-sketch">
        + Add Task
      </a>
    </div>
  </div>

  <div class="project-detail-grid">
    <!-- Main Content & Description -->
    <div class="wobbly-box project-main-box">
      <h2>Project Overview & Notes</h2>
      <hr class="hr-sketch" />
      <div class="markdown-body">
        <Content />
      </div>
    </div>

    <!-- Sidebar Stats & Task List -->
    <div class="project-sidebar">
      <div class="wobbly-box sidebar-box postit-card">
        <div class="tape-decoration"></div>
        <h3>Project Progress</h3>
        <div class="progress-number">{progress}%</div>
        <p>{doneCount} of {projectTasks.length} tasks completed</p>
        <div class="sketch-progress-bar" style="margin-top: 0.75rem;">
          <div class="progress-fill" style={`width: ${progress}%`}></div>
        </div>
      </div>

      <div class="wobbly-box sidebar-box">
        <h3>Project Tasks</h3>
        {projectTasks.length === 0 ? (
          <p class="empty-text">No tasks created yet for this project.</p>
        ) : (
          <ul class="task-list">
            {projectTasks.map((t) => (
              <li class="task-item">
                <a href={`/tasks/${t.slug || t.id}`} class="task-link">
                  {t.data.title}
                </a>
                <span class={`badge-sketch badge-${t.data.status}`}>{t.data.status}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-detail-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin: 1.5rem 0 2rem 0;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .project-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .header-right {
    display: flex;
    gap: 0.75rem;
  }
  .project-detail-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
  }
  .project-main-box {
    background-color: #ffffff;
    min-height: 400px;
  }
  .markdown-body {
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .project-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sidebar-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .progress-number {
    font-family: var(--font-heading);
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1;
  }
  .task-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
  }
  .task-link {
    font-weight: 700;
    color: var(--fg);
  }
  .empty-text {
    color: var(--muted-text);
    margin-top: 0.5rem;
  }
  @media (max-width: 768px) {
    .project-detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
