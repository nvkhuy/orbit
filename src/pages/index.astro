---
import BaseLayout from '../components/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import ProjectGrid from '../components/ProjectGrid';
import OrbitLogo from '../components/OrbitLogo.astro';
import { readProjectsFromDisk, readTasksFromDisk } from '../lib/content';

const rawProjects = readProjectsFromDisk();
const rawTasks = readTasksFromDisk();

const projects = rawProjects.map((p, index) => ({
  slug: p.id.replace(/\.md$/, ''),
  title: p.data.title,
  status: p.data.status,
  color: p.data.color || '#fff9c4',
  tags: p.data.tags,
  order: p.data.order ?? (index + 1) * 100,
})).sort((a, b) => a.order - b.order);

const tasks = rawTasks.map(t => ({
  slug: t.id.replace(/\.md$/, ''),
  title: t.data.title,
  project: t.data.project,
  status: t.data.status,
  priority: t.data.priority,
  assignee: t.data.assignee,
  updated: String(t.data.updated),
}));

// Quick Stats
const totalTasks = tasks.length;
const doneTasks = tasks.filter(t => t.status === 'done').length;
const inProgressTasks = tasks.filter(t => t.status === 'in-progress').length;
const todoTasks = tasks.filter(t => t.status === 'todo').length;

const dashboardProjects = projects.map(project => {
  const projectTasks = tasks.filter(task => task.project === project.slug);
  const projectDoneTasks = projectTasks.filter(task => task.status === 'done').length;

  return {
    ...project,
    doneTasks: projectDoneTasks,
    totalTasks: projectTasks.length,
    progressPct: projectTasks.length > 0
      ? Math.round((projectDoneTasks / projectTasks.length) * 100)
      : 0,
  };
});
---

<BaseLayout title="Orbit - Workspace Dashboard">
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    
    {/* Hero Section */}
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 0.75rem;">
      <div>
        <h1 style="font-size: 1.6rem; transform: rotate(-1deg); display: inline-flex; align-items: center; gap: 0.4rem;">
          <OrbitLogo size={34} />
          <span>Workspace</span>
        </h1>
        <p style="font-size: 1.05rem; color: var(--fg); opacity: 0.85;">
          Where humans & AI agents revolve around one shared Markdown workspace.
        </p>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/new?type=task" class="sketch-button" style="font-size: 0.95rem; padding: 0.35rem 1rem;">+ New Task</a>
        <a href="/board" class="sketch-button secondary" style="font-size: 0.95rem; padding: 0.35rem 1rem;">📋 View Board</a>
      </div>
    </div>

    {/* Quick Stats Grid */}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem;">
      <div class="sketch-card" style="text-align: center; padding: 0.75rem 1rem;">
        <div style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--fg); line-height: 1.1;">{totalTasks}</div>
        <div style="font-size: 0.9rem; opacity: 0.8;">Total Tasks</div>
      </div>
      <div class="sketch-card" style="text-align: center; padding: 0.75rem 1rem; background-color: #e8f5e9;">
        <div style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--fg); line-height: 1.1;">{doneTasks}</div>
        <div style="font-size: 0.9rem; opacity: 0.8;">Done</div>
      </div>
      <div class="sketch-card" style="text-align: center; padding: 0.75rem 1rem; background-color: #e3f2fd;">
        <div style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--fg); line-height: 1.1;">{inProgressTasks}</div>
        <div style="font-size: 0.9rem; opacity: 0.8;">In Progress</div>
      </div>
      <div class="sketch-card" style="text-align: center; padding: 0.75rem 1rem; background-color: #fffde7;">
        <div style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--fg); line-height: 1.1;">{todoTasks}</div>
        <div style="font-size: 0.9rem; opacity: 0.8;">To Do</div>
      </div>
    </div>

    {/* Active Projects Cards */}
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h2 style="font-size: 1.6rem; transform: rotate(1deg);">📁 Active Projects</h2>
        <a href="/new?type=project" style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--blue);">+ New Project</a>
      </div>

      <ProjectGrid client:load initialProjects={dashboardProjects} />
    </div>

    {/* Recent Tasks */}
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
        <h2 style="font-size: 1.6rem; transform: rotate(-1deg);">📌 Recent Tasks</h2>
        <a href="/list" style="font-family: var(--font-heading); font-size: 1.05rem; color: var(--blue);">View All Tasks →</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
        {tasks.slice(0, 6).map((task, tIdx) => (
          <div 
            class="sketch-card" 
            style={`cursor: pointer; transform: rotate(${tIdx % 2 === 0 ? '1deg' : '-1deg'}); padding: 0.75rem 0.9rem;`}
            onClick={`window.location.href='/tasks/${task.slug}'`}
          >
            <h3 style="font-size: 1.15rem; margin-bottom: 0.4rem;">
              <a href={`/tasks/${task.slug}`}>{task.title}</a>
            </h3>
            <div style="display: flex; gap: 0.4rem; align-items: center;">
              <Badge color={task.status === 'done' ? '#c8e6c9' : task.status === 'in-progress' ? '#bbdefb' : '#fff9c4'}>
                {task.status}
              </Badge>
              <span style="font-size: 0.8rem; color: #666;">in {task.project}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
