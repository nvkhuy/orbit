---
import BaseLayout from '../components/BaseLayout.astro';
import KanbanBoard from '../components/KanbanBoard';
import { readProjectsFromDisk, readTasksFromDisk } from '../lib/content';

const projectFilter = Astro.url.searchParams.get('project') || '';

const rawProjects = readProjectsFromDisk();
const rawTasks = readTasksFromDisk();

const projects = rawProjects.map(p => ({
  slug: p.id.replace(/\.md$/, ''),
  title: p.data.title,
  columns: p.data.columns,
  color: p.data.color,
}));

const tasks = rawTasks.map(t => ({
  slug: t.id.replace(/\.md$/, ''),
  title: t.data.title,
  project: t.data.project,
  status: t.data.status,
  priority: t.data.priority,
  assignee: t.data.assignee,
  tags: t.data.tags,
  due: t.data.due ? String(t.data.due) : undefined,
  order: t.data.order,
  parent: t.data.parent,
}));
---

<BaseLayout title="Orbit - Kanban Board">
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h1 style="font-size: 2rem; transform: rotate(-1deg);">📋 Workspace Board</h1>
    </div>

    <KanbanBoard 
      client:load 
      initialTasks={tasks} 
      projects={projects} 
      initialProjectFilter={projectFilter} 
    />
  </div>
</BaseLayout>
