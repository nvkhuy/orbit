---
import BaseLayout from '../components/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const tasks = await getCollection('tasks');

const totalTasks = tasks.length;
const doneTasks = tasks.filter((t) => t.data.status === 'done').length;
const inProgressTasks = tasks.filter((t) => t.data.status === 'in-progress').length;
const todoTasks = tasks.filter((t) => t.data.status === 'todo').length;

const completionPercentage = totalTasks > 0 ? Math.round((doneTasks / totalTasks) * 100) : 0;

// Project stats mapping
const projectStats = projects.map((p) => {
  const pTasks = tasks.filter((t) => t.data.project === p.slug || t.data.project === p.id);
  const pDone = pTasks.filter((t) => t.data.status === 'done').length;
  const percent = pTasks.length > 0 ? Math.round((pDone / pTasks.length) * 100) : 0;
  return {
    ...p,
    taskCount: pTasks.length,
    doneCount: pDone,
    progress: percent,
  };
});

const recentTasks = [...tasks]
  .sort((a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime())
  .slice(0, 5);
---

<BaseLayout title="Orbit — Workspace Dashboard">
  <div class="dashboard-header">
    <div class="header-titles">
      <h1>📊 Workspace Dashboard</h1>
      <p class="subtitle">Real-time overview of projects and tasks powered by local Markdown files.</p>
    </div>

    <div class="header-cta">
      <a href="/new" class="btn-sketch btn-sketch-yellow">
        ✏️ Quick Create
      </a>
      <a href="/board" class="btn-sketch">
        📋 Open Board
      </a>
    </div>
  </div>

  <!-- Overall Stat Cards Grid -->
  <div class="stats-grid">
    <div class="wobbly-box stat-card postit-card">
      <div class="tack-decoration"></div>
      <div class="stat-icon">📈</div>
      <div class="stat-number">{completionPercentage}%</div>
      <div class="stat-label">Overall Completion</div>
    </div>

    <div class="wobbly-box stat-card">
      <div class="stat-icon">📁</div>
      <div class="stat-number">{projects.length}</div>
      <div class="stat-label">Active Projects</div>
    </div>

    <div class="wobbly-box stat-card">
      <div class="stat-icon">📌</div>
      <div class="stat-number">{totalTasks}</div>
      <div class="stat-label">Total Tasks</div>
    </div>

    <div class="wobbly-box stat-card">
      <div class="stat-icon">✏️</div>
      <div class="stat-number">{inProgressTasks}</div>
      <div class="stat-label">In Progress</div>
    </div>
  </div>

  <hr class="hr-sketch" />

  <!-- Active Projects Section -->
  <section class="section-container">
    <div class="section-title-bar">
      <h2>📁 Projects Overview</h2>
    </div>

    <div class="projects-grid">
      {projectStats.map((p) => (
        <div class="wobbly-box project-card hover-rotate-1" style={`background-color: ${p.data.color || '#ffffff'}`}>
          <div class="card-top">
            <span class={`badge-sketch badge-${p.data.status}`}>{p.data.status}</span>
            <span class={`badge-sketch badge-${p.data.priority}`}>{p.data.priority}</span>
          </div>

          <a href={`/projects/${p.slug || p.id}`} class="project-title-link">
            <h3>{p.data.title}</h3>
          </a>

          <p class="project-tags">
            {p.data.tags?.map((tag: string) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </p>

          <div class="progress-section">
            <div class="progress-label-row">
              <span>Progress</span>
              <span>{p.progress}% ({p.doneCount}/{p.taskCount} done)</span>
            </div>
            <div class="sketch-progress-bar">
              <div class="progress-fill" style={`width: ${p.progress}%`}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="hr-sketch" />

  <!-- Recent Tasks Activity -->
  <section class="section-container">
    <div class="section-title-bar">
      <h2>🕒 Recent Activity</h2>
      <a href="/list" class="view-all-link">View all tasks →</a>
    </div>

    <div class="recent-tasks-list">
      {recentTasks.map((t) => (
        <div class="wobbly-box-sm recent-task-item">
          <div class="task-info">
            <span class={`badge-sketch badge-${t.data.status}`}>{t.data.status}</span>
            <a href={`/tasks/${t.slug || t.id}`} class="task-title">{t.data.title}</a>
            <span class="project-tag">[{t.data.project}]</span>
          </div>
          <div class="task-meta">
            <span class="assignee">Assigned to <strong>{t.data.assignee}</strong></span>
            <span class="updated-time">{t.data.updated}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0 2rem 0;
    flex-wrap: wrap;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--muted-text);
    margin-top: 0.25rem;
  }

  .header-cta {
    display: flex;
    gap: 1rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1rem;
  }

  .stat-icon {
    font-size: 2.2rem;
    margin-bottom: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--fg);
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 700;
    color: var(--muted-text);
    margin-top: 0.25rem;
  }

  .section-container {
    margin: 2rem 0;
  }

  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .view-all-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-title-link {
    color: var(--fg);
    text-decoration: none !important;
  }

  .project-title-link h3 {
    font-size: 1.5rem;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    font-size: 0.85rem;
    color: var(--muted-text);
    background-color: rgba(0, 0, 0, 0.05);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .progress-section {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .progress-label-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .sketch-progress-bar {
    height: 14px;
    background-color: rgba(0, 0, 0, 0.08);
    border: 2px solid var(--border);
    border-radius: var(--wobbly-3);
    overflow: hidden;
    position: relative;
  }

  .progress-fill {
    height: 100%;
    background-color: var(--accent-green);
    transition: width 0.3s ease;
  }

  .recent-tasks-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .recent-task-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .task-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .task-title {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--fg);
  }

  .project-tag {
    font-size: 0.9rem;
    color: var(--muted-text);
  }

  .task-meta {
    font-size: 0.95rem;
    color: var(--muted-text);
    display: flex;
    gap: 1rem;
  }
</style>
