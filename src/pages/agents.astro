---
import BaseLayout from '../components/BaseLayout.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import { readAgentsFromDisk } from '../lib/content';

const agents = readAgentsFromDisk();
---

<BaseLayout title="Orbit - Agent Hub">
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h1 style="font-size: 3rem; transform: rotate(-1deg);">🤖 Agent Hub</h1>
    </div>
    
    <p style="font-size: 1.25rem;">
      Agents in Orbit read and write markdown files directly. Below are registered human & AI collaborators:
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {agents.map(agent => (
        <Card decoration={agent.data.type === 'ai' ? 'tape' : 'tack'} postit={agent.data.type === 'ai'}>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <h2 style="font-size: 2rem;">{agent.data.name}</h2>
            <Badge color={agent.data.type === 'ai' ? '#bbdefb' : '#c8e6c9'}>
              {agent.data.type === 'ai' ? '🤖 AI Agent' : '🧑 Human'}
            </Badge>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem;">
            <p><strong>Permissions:</strong></p>
            <ul style="padding-left: 1.25rem;">
              {agent.data.permissions.map(perm => (
                <li style="font-size: 1.1rem; color: var(--fg);">{perm}</li>
              ))}
            </ul>
          </div>

          {agent.data.last_active && (
            <div style="margin-top: 1rem; font-size: 0.9rem; color: #666; border-top: 1px dashed var(--border); padding-top: 0.5rem;">
              Last Active: {String(agent.data.last_active)}
            </div>
          )}
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
