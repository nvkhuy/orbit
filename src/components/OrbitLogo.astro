---
interface Props {
  size?: number | string;
  class?: string;
  style?: string;
}

const { size = 36, class: className = '', style = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={`orbit-logo ${className}`}
  style={`display: inline-block; vertical-align: middle; flex-shrink: 0; filter: drop-shadow(2px 2px 0px var(--border)); ${style}`}
  aria-hidden="true"
>
  <!-- Back Orbit Ring Loop -->
  <path
    d="M 6 22 C 3 15, 14 8, 27 9 C 34 10, 37 13, 37 16.5"
    stroke="var(--fg)"
    stroke-width="3.5"
    stroke-linecap="round"
    fill="none"
  />

  <!-- Flat Yellow Central Planet -->
  <circle
    cx="20"
    cy="20"
    r="9.5"
    fill="#ffd54f"
    stroke="var(--fg)"
    stroke-width="3.5"
  />

  <!-- Front Orbit Ring Loop -->
  <path
    d="M 37 16.5 C 37 23.5, 26 31, 13 30 C 5 29.5, 3 26, 6 22"
    stroke="var(--fg)"
    stroke-width="3.5"
    stroke-linecap="round"
    fill="none"
  />

  <!-- Iconic Orbiting Red Satellite Dot -->
  <circle
    cx="33.5"
    cy="12.5"
    r="3.5"
    fill="var(--accent)"
    stroke="var(--fg)"
    stroke-width="2"
  />
</svg>
