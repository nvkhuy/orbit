---
import BaseLayout from '../components/BaseLayout.astro';
import KanbanBoard from '../components/KanbanBoard';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const tasks = await getCollection('tasks');

const initialTasks = tasks.map((t) => ({
  slug: t.slug || t.id,
  title: t.data.title,
  project: t.data.project,
  status: t.data.status,
  priority: t.data.priority,
  assignee: t.data.assignee,
  tags: t.data.tags,
  due: t.data.due,
  order: t.data.order,
  parent: t.data.parent,
  created: t.data.created,
  updated: t.data.updated,
  content: t.body,
}));

const projectList = projects.map((p) => ({
  slug: p.slug || p.id,
  title: p.data.title,
  color: p.data.color,
  status: p.data.status,
}));

const selectedProject = Astro.url.searchParams.get('project') || '';
---

<BaseLayout title="Orbit — Kanban Board">
  <div class="board-header">
    <div>
      <h1>📋 Drag-and-Drop Board</h1>
      <p class="subtitle">Drag cards between columns or reorder to instantly update <code>.md</code> files.</p>
    </div>
  </div>

  <KanbanBoard client:load initialTasks={initialTasks} projects={projectList} selectedProject={selectedProject} />
</BaseLayout>

<style>
  .board-header {
    margin: 1.5rem 0 1rem 0;
  }
  .subtitle {
    font-size: 1.15rem;
    color: var(--muted-text);
  }
</style>
